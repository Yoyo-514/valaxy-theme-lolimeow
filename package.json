{
  "type": "module",
  "private": true,
  "homepage": "https://lolimeow.yoyo514.top",
  "scripts": {
    "build": "pnpm run build:demo",
    "build:demo": "pnpm -C demo run build",
    "ci:publish": "pnpm -r publish --access public --no-git-checks",
    "dev": "pnpm run demo",
    "demo": "pnpm -C demo run dev",
    "demo:serve": "pnpm -C demo run serve",
    "docs:build": "pnpm -C docs run build",
    "docs:dev": "pnpm -C docs run dev",
    "docs:serve": "pnpm -C docs run serve",
    "lint": "eslint .",
    "test:colors": "vitest run tests/theme-colors.test.ts",
    "release": "cd theme && git add -A && bumpp --all",
    "typecheck": "node ./scripts/typecheck.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check:unused": "node scripts/check-unused.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@playwright/test": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "valaxy": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
